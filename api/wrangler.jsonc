{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growth-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "../web/out", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "growth-media" }],
  "durable_objects": { "bindings": [{ "name": "JOBS", "class_name": "JobStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JobStore"] }],
  "vars": {
    "GPU_USD_PER_SEC": "0.000208",
    "MONTHLY_BUDGET_USD": "10",
    "MAX_ATTEMPTS": "2",
    "GPU_ENABLED": "false"
  },
  "observability": { "enabled": true }
}
